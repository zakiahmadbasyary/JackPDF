/* ==========================================================================
   JackPDF Official Stylesheet
   Based on JackPDF Visual Design Guidelines
   Palette: Navy 950 (#071426), Blue 600 (#1D6FEA), Gray 50 (#F7F9FC)
   ========================================================================== */

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    color: #263445;
}

QMainWindow,
QWidget#CentralWidget,
QStackedWidget,
QWidget#ContentWidget {
    background: #F7F9FC;
}

QLabel {
    background: transparent;
    color: #263445;
}

/* --------------------------------------------------------------------------
   Sidebar (Dark Navy #071426)
   -------------------------------------------------------------------------- */
QFrame#Sidebar {
    background: #071426;
    border-right: 1px solid #142B4D;
}

QLabel#Brand {
    font-size: 18pt;
    font-weight: 700;
    color: #FFFFFF;
    padding: 2px 0;
}

QLabel#SidebarHint {
    color: #98A6B8;
    font-size: 8.5pt;
}

QLabel#SectionLabel {
    color: #98A6B8;
    font-size: 8pt;
    font-weight: 700;
    padding-top: 10px;
    letter-spacing: 1px;
}

QPushButton#NavButton {
    text-align: left;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #DCE3EC;
    font-size: 9.5pt;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background: #142B4D;
    color: #FFFFFF;
}

QPushButton#NavButton[active="true"] {
    background: #142B4D;
    color: #45C7F5;
    font-weight: 600;
    border-left: 3px solid #278BFA;
}

QPushButton#NavButton:disabled {
    color: #5D6B7D;
}

QLabel#LocalNote {
    color: #45C7F5;
    background: #0B1B33;
    border: 1px solid #142B4D;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 8.5pt;
    font-weight: 500;
}

/* --------------------------------------------------------------------------
   Headings & Text
   -------------------------------------------------------------------------- */
QLabel#PageTitle {
    font-size: 22pt;
    font-weight: 700;
    color: #111B29;
}

QLabel#PageSubtitle {
    color: #5D6B7D;
    font-size: 10pt;
}

QLabel#SectionTitle {
    font-size: 13pt;
    font-weight: 700;
    color: #111B29;
}

QLabel#Footer {
    color: #98A6B8;
    font-size: 9pt;
}

QLabel#StatusLabel {
    color: #263445;
    font-size: 9.5pt;
    padding: 2px 0;
}

QLabel#InputHint,
QLabel#TableHint {
    color: #5D6B7D;
    font-size: 8.5pt;
}

/* --------------------------------------------------------------------------
   Feature Cards (White #FFFFFF, Border #DCE3EC, Radius 14px)
   -------------------------------------------------------------------------- */
QFrame#FeatureCard {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 14px;
}

QFrame#FeatureCard:hover {
    border: 1px solid #278BFA;
    background: #FFFFFF;
}

QFrame#FeatureCard:hover QPushButton#CardAction {
    color: #1557B0;
}

QLabel#FeatureIcon {
    background: transparent;
    border: none;
}

QLabel#FeatureTitle {
    font-size: 11.5pt;
    font-weight: 700;
    color: #111B29;
}

QLabel#FeatureDescription {
    color: #5D6B7D;
    font-size: 9pt;
}

QPushButton#CardAction {
    color: #1D6FEA;
    background: transparent;
    border: none;
    padding: 2px 0;
    font-weight: 600;
    font-size: 9.5pt;
}

QPushButton#CardAction:hover {
    color: #1557B0;
}

/* --------------------------------------------------------------------------
   Drop Zones
   -------------------------------------------------------------------------- */
QFrame#DropZone {
    background: #FFFFFF;
    border: 1.5px dashed #98A6B8;
    border-radius: 14px;
    padding: 16px;
    min-height: 75px;
}

QFrame#DropZone:hover {
    border-color: #1D6FEA;
    background: #F0F6FF;
}

QLabel#DropTitle {
    font-size: 12pt;
    font-weight: 600;
    color: #111B29;
}

QLabel#DropHint {
    color: #5D6B7D;
    font-size: 9pt;
}

/* --------------------------------------------------------------------------
   Buttons
   -------------------------------------------------------------------------- */
QPushButton#PrimaryButton {
    background: #1D6FEA;
    color: #FFFFFF;
    border: none;
    border-radius: 9px;
    padding: 9px 18px;
    font-weight: 600;
    font-size: 9.5pt;
}

QPushButton#PrimaryButton:hover {
    background: #1557B0;
}

QPushButton#PrimaryButton:disabled {
    background: #DCE3EC;
    color: #98A6B8;
}

QPushButton#SecondaryButton {
    background: #FFFFFF;
    color: #263445;
    border: 1px solid #DCE3EC;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 500;
    font-size: 9.5pt;
}

QPushButton#SecondaryButton:hover {
    background: #EEF2F7;
    border-color: #98A6B8;
    color: #111B29;
}

QPushButton#SecondaryButton:disabled {
    color: #98A6B8;
    border-color: #EEF2F7;
    background: #F7F9FC;
}

QPushButton#ActionLargeButton {
    background: #1D6FEA;
    color: #FFFFFF;
    border: none;
    border-radius: 9px;
    padding: 11px 24px;
    font-size: 10.5pt;
    font-weight: 700;
}

QPushButton#ActionLargeButton:hover {
    background: #1557B0;
}

QPushButton#ActionLargeButton:disabled {
    background: #DCE3EC;
    color: #98A6B8;
}

QPushButton#IconButton {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 9px;
    color: #263445;
}

QPushButton#IconButton:hover {
    background: #EEF2F7;
    border-color: #98A6B8;
    color: #1D6FEA;
}

QPushButton#TableDeleteBtn {
    background: #FFFFFF;
    color: #D64545;
    border: 1px solid #FCD4D4;
    border-radius: 6px;
    padding: 3px 12px;
    font-size: 8.5pt;
    font-weight: 600;
    min-height: 22px;
}

QPushButton#TableDeleteBtn:hover {
    background: #FFF1F1;
    border-color: #D64545;
    color: #B91C1C;
}

QPushButton#TableDeleteBtn:pressed {
    background: #FEE2E2;
}

QWidget#RowActionContainer {
    background: transparent;
}

/* --------------------------------------------------------------------------
   Tables
   -------------------------------------------------------------------------- */
QTableWidget#FileTable {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 10px;
    gridline-color: #EEF2F7;
    selection-background-color: #DCEBFF;
    selection-color: #111B29;
}

QTableWidget#FileTable::item {
    padding: 6px;
}

QHeaderView::section {
    background: #F7F9FC;
    color: #5D6B7D;
    font-weight: 600;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #DCE3EC;
}

/* --------------------------------------------------------------------------
   Inputs, Radios & Sliders
   -------------------------------------------------------------------------- */
QLineEdit#StyledInput,
QSpinBox#StyledSpinBox {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 8px;
    padding: 7px 12px;
    color: #111B29;
}

QLineEdit#StyledInput:focus,
QSpinBox#StyledSpinBox:focus {
    border: 1.5px solid #278BFA;
    background: #FFFFFF;
}

QRadioButton#RadioChoice {
    color: #263445;
    font-size: 10pt;
    spacing: 8px;
}

QRadioButton#RadioChoice::indicator {
    width: 16px;
    height: 16px;
}

QFrame#InfoCard {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 12px;
}

/* --------------------------------------------------------------------------
   Progress Bar
   -------------------------------------------------------------------------- */
QProgressBar#MergeProgressBar {
    background: #EEF2F7;
    border-radius: 5px;
    height: 9px;
    text-align: center;
}

QProgressBar#MergeProgressBar::chunk {
    background: #1D6FEA;
    border-radius: 5px;
}

/* --------------------------------------------------------------------------
   Menus & Tooltips
   -------------------------------------------------------------------------- */
QMenu {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 18px 7px 12px;
    border-radius: 6px;
    color: #263445;
    font-size: 9.5pt;
}

QMenu::item:selected {
    background: #DCEBFF;
    color: #1557B0;
}

QMenu::separator {
    height: 1px;
    background: #EEF2F7;
    margin: 4px 6px;
}

QToolTip {
    color: #FFFFFF;
    background: #0B1B33;
    border: 1px solid #142B4D;
    padding: 7px 9px;
    border-radius: 6px;
}

/* --------------------------------------------------------------------------
   Scroll Areas & Bars
   -------------------------------------------------------------------------- */
QScrollArea#ContentScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
}

QScrollBar::handle:vertical {
    background: #DCE3EC;
    min-height: 36px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #98A6B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* --------------------------------------------------------------------------
   Document Preview Side Panel
   -------------------------------------------------------------------------- */
QFrame#PreviewCard {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 12px;
}

QLabel#PreviewTitle {
    font-size: 10pt;
    font-weight: 700;
    color: #111B29;
}

QLabel#PreviewBadge {
    background: #EEF2F7;
    color: #1D6FEA;
    font-size: 8.5pt;
    font-weight: 600;
    border-radius: 9px;
    padding: 2px 8px;
}

QFrame#PreviewCanvas {
    background: #F7F9FC;
    border: 1px solid #EEF2F7;
    border-radius: 8px;
    min-height: 250px;
}

QLabel#PreviewImage {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 4px;
    padding: 2px;
}

QLabel#PreviewEmptyIcon {
    font-size: 26pt;
    color: #98A6B8;
}

QLabel#PreviewEmptyText {
    color: #5D6B7D;
    font-size: 8.5pt;
}

QPushButton#PreviewNavBtn {
    background: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 6px;
    color: #263445;
    font-size: 8.5pt;
    font-weight: 700;
    min-width: 32px;
    max-width: 32px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#PreviewNavBtn:hover {
    background: #EEF2F7;
    border-color: #98A6B8;
    color: #1D6FEA;
}

QPushButton#PreviewNavBtn:disabled {
    background: #F7F9FC;
    border-color: #EEF2F7;
    color: #CBD5E1;
}

QLabel#PreviewNavLabel {
    font-size: 8.5pt;
    font-weight: 500;
    color: #5D6B7D;
}

QLabel#PreviewDocName {
    font-size: 9pt;
    font-weight: 700;
    color: #111B29;
}

QLabel#PreviewDocMeta {
    font-size: 8pt;
    color: #5D6B7D;
}
